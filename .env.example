# QuestAI Environment Configuration

# Django
DEBUG=True
SECRET_KEY=django-insecure-questai-development-key-change-in-production-12345
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Ollama AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set to True for running tasks synchronously in-process without requiring Redis daemon
CELERY_ALWAYS_EAGER=False

